# Copy this file to .env only when overriding the default local mock API URL.
# The pipeline also works when this file is absent.
API_URL=http://127.0.0.1:5000/students

# ===== MongoDB Configuration =====
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=university_ai
MONGO_COLLECTION=students
MONGO_TIMEOUT_MS=5000
MONGO_ENABLED=false